# Active university tenant folder inside tenant_packs/
ARCHITECT_TENANT=hmc-makerspace

# Optional custom path to tenant packs directory (defaults to ./tenant_packs)
ARCHITECT_TENANT_DIR=./tenant_packs

# Optional database URL (defaults to local SQLite; can point to PostgreSQL to bridge with E190-Final-Project)
DATABASE_URL=sqlite:///./architect_mcp.db

# Default token budget for the Dynamic Context Harness
ARCHITECT_TOKEN_BUDGET=4000
